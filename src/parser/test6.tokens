# Test 6: Subprogram parameters and compound statement grammar rules (Section 3)
# Covers: subprogram_body with both const AND var, compound_statement with statements,
#         statement_list with multiple statements, nested compound_statement,
#         value_parameter with 3-id idlist (deep recursion)
# Source:
#   program TestCompoundStmt;
#   var
#     x, y: integer;
#     a: real;
#
#   procedure FullBody(n: integer; var m: integer);
#   const
#     LOCAL_MAX = 50;
#   var
#     temp: integer;
#   begin
#     temp := n;
#     m := temp
#   end;
#
#   function Calc(a, b, c: integer): integer;
#   var
#     r: integer;
#   begin
#     r := a;
#     r := b;
#     r := c
#   end;
#
#   begin
#     x := 1;
#     y := 2;
#     begin
#       a := 3
#     end;
#     x := y
#   end.
#
# Line 1: program TestCompoundStmt;
PROGRAM program 1 1
ID TestCompoundStmt 1 9
SEMICOLON ; 1 25
# Line 2: var
VAR var 2 1
# Line 3: x, y: integer;
ID x 3 3
COMMA , 3 4
ID y 3 6
COLON : 3 7
INTEGER integer 3 9
