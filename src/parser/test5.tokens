PROCEDURE procedure 10 1
ID SimpleProc 10 11
SEMICOLON ; 10 21
# Line 11: begin
BEGIN begin 11 1
# Line 12: end;
END end 12 1
SEMICOLON ; 12 4
# Line 13: (empty)
# Line 14: procedure ProcWithParams(x, y: integer; var z: real);
PROCEDURE procedure 14 1
ID ProcWithParams 14 11
LPAREN ( 14 25
