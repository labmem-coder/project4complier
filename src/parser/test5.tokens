ID y 14 29
COLON : 14 30
INTEGER integer 14 32
SEMICOLON ; 14 39
VAR var 14 41
ID z 14 45
COLON : 14 46
REAL real 14 48
RPAREN ) 14 52
SEMICOLON ; 14 53
# Line 15: begin
BEGIN begin 15 1
# Line 16: end;
END end 16 1
SEMICOLON ; 16 4
# Line 17: (empty)
# Line 18: function Add(a, b: integer): integer;
FUNCTION function 18 1
ID Add 18 10
LPAREN ( 18 13
