# Test 5: Variable and subprogram declaration grammar rules (Section 2)
# Covers: var_declaration chaining, all 4 basic_types, array with single/multi period,
#         procedure (with/without params), function with return type,
#         value_parameter, var_parameter, parameter_list chaining,
#         subprogram_body with const/var declarations
# Source:
#   program TestVarSubprog;
#   var
#     x, y: integer;
#     a, b: real;
#     flag: boolean;
#     ch: char;
#     arr: array [1..10] of integer;
#     matrix: array [1..3, 1..4] of real;
#
#   procedure SimpleProc;
#   begin
#   end;
#
#   procedure ProcWithParams(x, y: integer; var z: real);
#   begin
#   end;
#
#   function Add(a, b: integer): integer;
#   var
#     result: integer;
#   begin
#   end;
#
#   function GetFlag(var s: char; n: integer): boolean;
#   const
#     LIMIT = 100;
#   begin
#   end;
#
#   begin
#   end.
#
# Line 1: program TestVarSubprog;
PROGRAM program 1 1
ID TestVarSubprog 1 9
SEMICOLON ; 1 23
# Line 2: var
VAR var 2 1
# Line 3: x, y: integer;
ID x 3 3
COMMA , 3 4
ID y 3 6
COLON : 3 7
INTEGER integer 3 9
SEMICOLON ; 3 16
# Line 4: a, b: real;
ID a 4 3
COMMA , 4 4
ID b 4 6
COLON : 4 7
REAL real 4 9
SEMICOLON ; 4 13
# Line 5: flag: boolean;
ID flag 5 3
COLON : 5 7
BOOLEAN boolean 5 9
SEMICOLON ; 5 16
# Line 6: ch: char;
ID ch 6 3
COLON : 6 5
CHAR char 6 7
SEMICOLON ; 6 11
# Line 7: arr: array [1..10] of integer;
ID arr 7 3
COLON : 7 6
ARRAY array 7 8
LBRACKET [ 7 14
NUMBER 1 7 15
DOTDOT .. 7 16
NUMBER 10 7 18
RBRACKET ] 7 20
OF of 7 22
INTEGER integer 7 25
SEMICOLON ; 7 32
# Line 8: matrix: array [1..3, 1..4] of real;
ID matrix 8 3
COLON : 8 9
ARRAY array 8 11
LBRACKET [ 8 17
NUMBER 1 8 18
DOTDOT .. 8 19
NUMBER 3 8 21
COMMA , 8 22
NUMBER 1 8 24
DOTDOT .. 8 25
NUMBER 4 8 27
RBRACKET ] 8 28
OF of 8 30
REAL real 8 33
SEMICOLON ; 8 37
